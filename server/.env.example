# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要提交到仓库

# ---------- 腾讯云 COS ----------
# 存储桶名称，必须带 APPID 后缀（控制台桶列表里显示的完整名称）
COS_BUCKET=file-1250000000
# 存储桶地域。务必和这台服务器同地域，这样走内网、流量免费
COS_REGION=ap-guangzhou
# 腾讯云 API 密钥，建议用只授权了这一个桶的子账号
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- 应用 ----------
# JWT 签名密钥，至少 32 位随机字符串
# 可用这条命令生成：openssl rand -base64 48
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 服务 ----------
# 监听端口，需与 nginx 反向代理配置一致
PORT=3000
# 默认只监听回环地址，由 nginx 对外提供服务
HOST=127.0.0.1

# 单文件上传大小上限（MB）
# 上传走 multipart 且会在内存中缓存，请根据服务器内存量力设置
MAX_UPLOAD_MB=200

# 允许跨域的前端域名，多个用英文逗号分隔
# 前后端同域名部署（推荐）时留空即可
ALLOWED_ORIGINS=

# 可选：由本进程直接托管前端静态文件
# 用 nginx 托管前端时不要设置这项
# STATIC_DIR=../frontend/dist
